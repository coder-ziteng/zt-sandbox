# Copy to `.env` and fill in real values before running any deploy script.
# `.env` is gitignored; never commit it.

# ---- SSH access to the sandbox host (used by deploy_server.py, check_deploy.py, etc.) ----
SBX_SSH_HOST=192.168.x.x
SBX_SSH_USER=root
SBX_SSH_PASSWORD=
# Optional: defaults to 22
# SBX_SSH_PORT=22

# ---- Control-plane API keys (used to register templates / query sandboxes) ----
# Comma-separated list, e.g. "<your-key-1>,<your-key-2>".
# Choose a long random value; the official e2b SDK requires a key with the `e2b_` prefix.
SBX_API_KEYS=

# ---- Optional: identity binding for multi-tenant isolation ----
# When set, every API key is bound to an (owner, tenant) tuple. Sandbox
# create/list/get enforces that the caller's identity matches the sandbox's
# stored identity — cross-tenant / cross-owner access returns 403.
# Format: semicolon-separated `key:owner:tenant` (quote-free — docker compose
# env-files strip quotes from JSON values, so we use a colon format).
# Leave empty to disable isolation (single-key legacy mode).
# Example:
#   SBX_API_KEYS_JSON=k_alice:alice:acme;k_bob:bob:acme;k_eve:eve:evil
SBX_API_KEYS_JSON=

# ---- Optional: separate credential for /admin/* (key management) ----
# If left blank, deploy_server.py generates a long random one and prints it
# once. Rotate by setting a new value and restarting the control plane.
# This is the ONLY credential accepted on /admin/keys (list/create/revoke) —
# data-plane API keys are explicitly rejected there.
SBX_ADMIN_TOKEN=

# ---- Public domain used by the edge proxy (defaults to ${SBX_SSH_HOST}.nip.io) ----
# SBX_DOMAIN=